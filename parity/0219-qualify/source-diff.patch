+        put(
+            &mut out,
+            &[
+                f(g.center[0]),
+                f(g.center[1]),
+                f(g.center[2]),
+                f(g.radius),
+                f(g.error),
+                g.depth as u32,
+                g.first_cluster,
+                g.cluster_count,
+                first_page,
+                page_count,
+                offsets[k + 1] - offsets[k],
+                0,
+            ],
+        );
+    }
+    align(&mut out);
+    for n in &nodes {
+        put(
+            &mut out,
+            &[
+                f(n.bounds.center[0]),
+                f(n.bounds.center[1]),
+                f(n.bounds.center[2]),
+                f(n.bounds.radius),
+                f(n.bounds.error),
+                n.group as u32,
+                n.child_offset,
+                n.child_count,
+            ],
