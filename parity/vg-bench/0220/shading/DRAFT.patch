+                let attrs=view.attributes(c).map_err(|e|format!("{e:?}"))?.ok_or("missing attributes")?;
+                let channel=|tag| (0..attrs.channel_count()).find(|&k|attrs.channel(k).is_ok_and(|c|c.tag==tag)).ok_or("missing channel");
+                let nc=channel(1)?;let uc=channel(2)?;let tc=if with_tangent {Some(channel(3)?)} else {None};
+                for v in 0..nv {
+                    let normal=attrs.decode(nc,v).map_err(|e|format!("{e:?}"))?;n.push([normal[0],normal[1],normal[2]]);
+                    let value=attrs.decode(uc,v).map_err(|e|format!("{e:?}"))?;uv.push([value[0],value[1]]);
+                    if let Some(k)=tc {t.push(attrs.decode(k,v).map_err(|e|format!("{e:?}"))?);}
+                }
+                let start=u32::try_from(ix.len()).map_err(|e|e.to_string())?;
+                let mut triangles=[[0u8;3];256];let nt=view.decode_triangles(c,&mut triangles).map_err(|e|format!("{e:?}"))?;
+                for tri in &triangles[..nt] {ix.extend(tri.map(|v|base+u32::from(v)));}
+                let (center,radius)=r.cluster_sphere(global).map_err(|e|format!("{e:?}"))?;
+                let record=&mut old[global];
+                record.first_index=start;record.index_count=(nt*3) as u32;
+                record.refined=r.cluster_refined(global).map_err(|e|format!("{e:?}"))?;
+                record.center=center;record.radius=radius;
+                assert_eq!(nt,desc.triangle_count as usize);
+            }
+        }
+        // Resident groups are coarse-first; the public CPU cut tables are fine-first.
+        let mut groups=Vec::new();let mut clusters=Vec::new();
+        for old_id in (0..m.group_count as usize).rev() {
+            let g=r.group(old_id).map_err(|e|format!("{e:?}"))?;
+            let gid=groups.len() as u32;let first=clusters.len() as u32;
+            for cid in g.first_cluster..g.first_cluster+g.cluster_count {
+                let mut c=old[cid as usize];c.group=gid;
+                if c.refined>=0 {c.refined=m.group_count as i32-1-c.refined;}
+                clusters.push(c);
+            }
+            let mut group=FlatDagGroup::default();group.center=g.center;group.radius=g.radius;group.error=g.error;
+            group.depth=g.depth as i32;group.first_cluster=first;group.cluster_count=g.cluster_count;
+            groups.push(group);
+        }
+        cut::check_monotonic(&groups,&clusters).map_err(|e|format!("decoded cut monotonicity: {e:?}"))?;
+        Ok(Self{groups,clusters,p,n,uv,t,ix,q:f64::from(m.max_displacement)})
+    }
+    fn mesh<'a>(&'a self,ix:&'a [u32])->Mesh<'a> {Mesh{p:&self.p,n:&self.n,uv:&self.uv,t:&self.t,ix}}
+    fn select(&self,view:&CutView,threshold:Threshold)->R<Vec<u32>> {
+        let mut out=vec![0;self.clusters.len()];
+        let n=cut::select_cut(&self.groups,&self.clusters,view,threshold,None,&mut out).map_err(|e|format!("{e:?}"))?;
+        out.truncate(n);out.sort_unstable();Ok(out)
+    }
+    fn indices(&self,ids:&[u32])->Vec<u32> {
+        ids.iter().flat_map(|&id| {let c=&self.clusters[id as usize];self.ix[c.first_index as usize..(c.first_index+c.index_count) as usize].iter().copied()}).collect()
+    }
+    fn claim(&self,ids:&[u32])->f64 {
+        ids.iter().map(|&id| {let r=self.clusters[id as usize].refined;if r<0 {self.q}else{f64::from(self.groups[r as usize].error)}}).fold(self.q,f64::max)
+    }
+}
+struct Measured {
+    frequency:usize,triangles:usize,normal:Vec<f32>,uv:Vec<f32>,tangent:Vec<f32>,
+    normal_max:f64,tangent_max:f64,geometry:f64,ratio:f64,sign_mismatches:u64,
+}
+fn measure_cut(dag:&Decoded,ids:&[u32],frequency:usize,source_tree:&Tree<'_>,source_samples:&[Probe],samples:usize)->R<Measured> {
+    let indices=dag.indices(ids);let mesh=dag.mesh(&indices);let tree=Tree::new(mesh)?;
+    let reverse=mesh.samples(samples)?;
+    let mut row=Measured{frequency,triangles:indices.len()/3,normal:Vec::with_capacity(samples*2),uv:Vec::with_capacity(samples*2),tangent:Vec::new(),normal_max:0.,tangent_max:0.,geometry:0.,ratio:0.,sign_mismatches:0};
+    let tangents=!mesh.t.is_empty() && !source_tree.mesh.t.is_empty();
+    for (points,target) in [(source_samples,&tree),(reverse.as_slice(),source_tree)] {
+        for point in points {
+            let hit=target.nearest(point.p);let other=target.mesh.at(hit.id,hit.w);
+            let normal=angle(point.normal,other.normal);row.normal.push(normal as f32);row.normal_max=row.normal_max.max(normal);
+            let uv=((point.uv[0]-other.uv[0]).powi(2)+(point.uv[1]-other.uv[1]).powi(2)).sqrt();
+            if !uv.is_finite() || !normal.is_finite() {return Err("nonfinite probe measurement".into());}
+            row.uv.push(uv as f32);
+            row.geometry=row.geometry.max(hit.d.sqrt());
+            if tangents {
+                let value=angle(point.tangent,other.tangent);
+                row.tangent.push(value as f32);row.tangent_max=row.tangent_max.max(value);
+                row.sign_mismatches+=u64::from(point.sign!=other.sign);
+            }
+        }
+    }
+    row.ratio=row.geometry/dag.claim(ids);
+    if !row.ratio.is_finite() {return Err("nonfinite geometric ratio".into());}
+    row.normal.sort_unstable_by(f32::total_cmp);row.uv.sort_unstable_by(f32::total_cmp);row.tangent.sort_unstable_by(f32::total_cmp);
+    Ok(row)
+}
+fn quantile<'a>(values:impl Iterator<Item=(&'a [f32],usize)>+Clone,q:f64)->f64 {
+    let count:usize=values.clone().map(|(v,f)|v.len()*f).sum();
+    if count==0 {return 0.0;}
+    let rank=((count as f64*q).ceil() as usize).max(1);
+    let mut lo=values.clone().filter_map(|(v,_)|v.first()).map(|x|x.to_bits()).min().unwrap_or(0);
+    let mut hi=values.clone().filter_map(|(v,_)|v.last()).map(|x|x.to_bits()).max().unwrap_or(0);
+    while lo<hi {
+        let mid=lo+(hi-lo)/2;
+        let n:usize=values.clone().map(|(v,f)|v.partition_point(|x|x.to_bits()<=mid)*f).sum();
+        if n>=rank {hi=mid;}else{lo=mid+1;}
+    }
+    f64::from(f32::from_bits(lo))
+}
+pub fn evaluate(args:&[String])->R<()> {
+    let positional=crate::positional(args);
+    let path=positional.first().ok_or("shade-eval source.vgm artifact...")?;
+    if positional.len()<2 {return Err("missing shade artifacts".into());}
+    let samples=crate::num(args,"--samples",65536usize);
+    if samples==0 {return Err("zero probes".into());}
+    let dirs=crate::num(args,"--dirs",64usize);let jobs=crate::num(args,"--jobs",8usize);
+    if dirs==0 || jobs==0 {return Err("zero directions/jobs".into());}
+    let mut source=Source::load(Path::new(path.as_str()))?;
+    let tangent_stats=match crate::flag(args,"--with-tangents").as_deref() { Some("1")=>source.derive_tangents()?, None|Some("0")=>(0,0), _=>return Err("with-tangents needs 0 or 1".into()) };
+    let src=Mesh{p:&source.positions,n:&source.normals,uv:&source.uvs,t:&source.tangents,ix:&source.indices};
+    let source_tree=Tree::new(src)?;let probes=src.samples(samples)?;
+    let pool=rayon::ThreadPoolBuilder::new().num_threads(jobs).build().map_err(|e|e.to_string())?;
+    let directions=camera::directions(dirs);let spans=[64.,128.,256.,512.,1024.,2048.];
+    for artifact in &positional[1..] {
+        let dag=Decoded::read(Path::new(artifact.as_str()))?;
+        if !dag.t.is_empty() && source.tangents.is_empty() {return Err("artifact tangents require source tangents".into());}
+        let mut unique:BTreeMap<Vec<u32>,usize>=BTreeMap::new();
+        for &span in &spans {for &direction in &directions {
+            let eye=camera::View::orbit(direction,camera::distance_for_span(f64::from(source.radius()),span)).eye;
+            let view=CutView{position:eye.map(|x|x as f32),projection:Projection::Perspective{proj_y:camera::proj11() as f32,znear:camera::NEAR as f32},viewport_height:camera::VIEWPORT_H as f32,scale:1.0};
+            let ids=dag.select(&view,Threshold::Pixels(1.0))?;
+            if unique.is_empty() {
+                let finest=dag.select(&view,Threshold::Finest)?;
+                if dag.indices(&finest).len()!=source.indices.len() {return Err("finest triangle identity".into());}
+                let mut oracle=vec![0;dag.clusters.len()];
+                let n=cut::refine_sequential(&dag.groups,&dag.clusters,&view,Threshold::Pixels(1.0),None,&mut oracle).map_err(|e|format!("cut oracle: {e:?}"))?;
+                oracle.truncate(n);oracle.sort_unstable();if oracle!=ids {return Err("cut oracle mismatch".into());}
+            }
+            *unique.entry(ids).or_default()+=1;
+        }}
+        let cases:Vec<_>=unique.into_iter().collect();
+        let measured:Vec<Measured>=pool.install(||cases.par_iter().map(|(ids,f)|measure_cut(&dag,ids,*f,&source_tree,&probes,samples)).collect::<R<Vec<_>>>())?;
+        let views=dirs*spans.len();
+        let avg=measured.iter().map(|r|r.triangles*r.frequency).sum::<usize>() as f64/views as f64;
+        let ratios:Vec<f64>=measured.iter().flat_map(|r|std::iter::repeat_n(r.ratio,r.frequency)).collect();
+        let mut ratios=ratios;ratios.sort_by(f64::total_cmp);
+        let q=|v:&[f64],f:f64|v[((v.len() as f64*f).ceil() as usize).saturating_sub(1)];
+        let mut line=Json::new().text("kind","shading_cut").text("artifact",artifact)
+            .with("threshold_px",1).with("views",views).with("unique_cuts",measured.len())
+            .with("samples_each_direction",samples).with("pooled_samples",2*samples*views)
+            .with("mean_triangles",avg)
+            .with("normal_p95_deg",quantile(measured.iter().map(|r|(r.normal.as_slice(),r.frequency)),0.95))
+            .with("normal_max_deg",measured.iter().map(|r|r.normal_max).fold(0.,f64::max))
+            .with("uv_p95",quantile(measured.iter().map(|r|(r.uv.as_slice(),r.frequency)),0.95))
+            .with("geometric_median_ratio",q(&ratios,0.5)).with("geometric_p95_ratio",q(&ratios,0.95)).with("geometric_max_ratio",q(&ratios,1.0))
+            .with("tangent_degenerate_triangles",tangent_stats.0).with("tangent_fallback_vertices",tangent_stats.1)
+            .with("cut_oracle_pass",true);
+        if !dag.t.is_empty() {
+            line=line.with("tangent_p95_deg",quantile(measured.iter().map(|r|(r.tangent.as_slice(),r.frequency)),0.95))
+                .with("tangent_max_deg",measured.iter().map(|r|r.tangent_max).fold(0.,f64::max))
+                .with("tangent_sign_mismatch_fraction",measured.iter().map(|r|r.sign_mismatches*r.frequency as u64).sum::<u64>() as f64/(2*samples*views) as f64);
+        }
+        println!("{line}");
+    }
+    Ok(())
+}
