+    fn nearest_tree_matches_brute_force_with_ties_and_degenerates() {
+        let mut p=Vec::new();
+        for id in 0..32 {
+            let x=(id%4) as f32*0.7;let y=(id/4) as f32*0.4;
+            let z=((id*7)%11) as f32*0.13;
+            p.extend([[x,y,z],[x+0.3,y,z+0.1],[x,y+0.2,z-0.1]]);
+        }
+        let first=[p[0],p[1],p[2]];p.extend(first);p.extend([[2.,2.,2.];3]);
+        let n=vec![[0.,0.,1.];p.len()];let uv=vec![[0.,0.];p.len()];
+        let ix:Vec<_>=(0..p.len() as u32).collect();
+        let mesh=Mesh{p:&p,n:&n,uv:&uv,t:&[],ix:&ix};let tree=Tree::new(mesh).expect("tree");
+        let queries=p.iter().map(|x|x.map(f64::from)).chain((0..101).map(|i|[
+            (i%17) as f64*0.23-0.4,(i%13) as f64*0.31-0.2,(i%7) as f64*0.21-0.3]));
+        for point in queries {
+            let mut brute=Hit{d:f64::INFINITY,id:usize::MAX,w:[0.;3]};
+            for id in 0..ix.len()/3 {
+                let (d,w)=closest(mesh.triangle(id),point);
+                if d<brute.d || (d==brute.d && id<brute.id) {brute=Hit{d,id,w};}
+            }
+            let hit=tree.nearest(point);
+            assert_eq!(hit.id,brute.id,"query {point:?}");
+            assert_eq!(hit.d.to_bits(),brute.d.to_bits());assert_eq!(hit.w,brute.w);
+        }
+    }
