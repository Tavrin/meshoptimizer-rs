+#[cfg(feature="path-c")]
+fn repeat_six(payload: &MeshGeometryPayload, out: &str) -> Result<(),Box<dyn std::error::Error>> {
+ use meshoptimizer_rs::{Workspace,Positions,ByteOrder,SimplifySettings,SimplifyOptions};
+ let indices:Vec<u32>=payload.index_bytes.chunks_exact(4).map(|b|u32::from_le_bytes(b.try_into().unwrap())).collect();
+ let stride=mesh_vertex_stride_for_layout(&payload.vertex_layout).ok_or("layout")?;
+ let positions=Positions::from_bytes(&payload.vertex_bytes,payload.vertex_count as usize,stride,0,ByteOrder::LittleEndian)?;
+ let settings=SimplifySettings{target_index_count:(indices.len()/6)*3,target_error:0.01,options:SimplifyOptions::EMPTY};
+ let mut ws=Workspace::default();
+ let mut outputs=Vec::with_capacity(6);
+ let start=Instant::now();
+ for _ in 0..6 {outputs.push(meshoptimizer_rs::simplify(&indices,positions,settings,&mut ws));}
+ let ns=start.elapsed().as_nanos().to_string();
+ let records:Vec<Value>=outputs.into_iter().map(|r|match r {Ok(r)=>json!({"count":r.indices.len(),"sha256":hash(&r.indices.iter().flat_map(|i|i.to_le_bytes()).collect::<Vec<_>>()),"error_bits":r.error.to_bits()}),Err(e)=>json!({"error":format!("{e:?}")})}).collect();
+ fs::write(out,serde_json::to_vec(&json!({"ns":ns,"calls":records}))?)?;
+ Ok(())
+}
